+  async acquireRun(chatId: string, token: string, expiresAt: string): Promise<boolean> {
+    const result = await this.chatsCollection.updateOne(
+      { _id: new ObjectId(chatId), $or: [
+        { runLease: { $exists: false } },
+        { 'runLease.expiresAt': { $lte: new Date().toISOString() } },
+      ] },
+      { $set: { runLease: { token, expiresAt } } },
+    );
+    return result.matchedCount === 1;
+  }
+
+  async renewRun(chatId: string, token: string, expiresAt: string): Promise<boolean> {
+    const result = await this.chatsCollection.updateOne(
+      { _id: new ObjectId(chatId), 'runLease.token': token,
+        'runLease.expiresAt': { $gt: new Date().toISOString() } },
+      { $set: { 'runLease.expiresAt': expiresAt } },
+    );
+    return result.matchedCount === 1;
+  }
+
+  // Save the structured state and its UI transcript together, fenced by the lease.
+  async commitRun(
+    chatId: string,
+    token: string,
+    state: unknown,
+    messages: Array<Omit<ChatMessage, 'id' | 'createdAt'>> = [],
+  ): Promise<Chat> {
+    const now = new Date().toISOString();
+    const added = messages.map(message => ({
+      ...message, id: new ObjectId().toString(), createdAt: now,
+    }));
+    const result = await this.chatsCollection.findOneAndUpdate(
+      { _id: new ObjectId(chatId), 'runLease.token': token,
+        'runLease.expiresAt': { $gt: now } },
+      { $set: { state, updatedAt: now },
+        ...(added.length ? { $push: { messages: { $each: added } } } : {}),
+      },
+      { returnDocument: 'after' },
+    );
+    if (!result) throw new Error('Chat ownership was lost. Reload before continuing.');
+    return convertChat(result);
+  }
+
+  async releaseRun(chatId: string, token: string): Promise<void> {
+    await this.chatsCollection.updateOne(
+      { _id: new ObjectId(chatId), 'runLease.token': token },
+      { $unset: { runLease: '' } },
+    );
+  }
